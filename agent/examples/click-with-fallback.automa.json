        "position": {
          "x": 376,
          "y": 120
        },
        "data": {
          "disableBlock": false,
          "description": "",
          "url": "https://example.com",
          "userAgent": "",
          "active": true,
          "tabZoom": 1,
          "inGroup": false,
          "waitTabLoaded": true,
          "updatePrevTab": false,
          "customUserAgent": false,
          "onError": {
            "enable": true,
            "retry": true,
            "retryTimes": 2,
            "retryInterval": 1,
            "toDo": "error"
          }
        }
      },
      {
        "id": "click",
        "label": "event-click",
        "type": "BlockBasic",
        "position": {
          "x": 656,
          "y": 120
        },
        "data": {
          "disableBlock": false,
          "description": "Click More information",
          "findBy": "cssSelector",
          "waitForSelector": true,
          "waitSelectorTimeout": 5000,
          "selector": "a[href=\"https://www.iana.org/domains/example\"]",
          "markEl": false,
          "multiple": false,
          "onError": {
            "enable": true,
            "retry": true,
            "retryTimes": 2,
            "retryInterval": 1,
            "toDo": "fallback"
          }
        }
      },
      {
        "id": "ok",
        "label": "insert-data",
        "type": "BlockBasic",
        "position": {
          "x": 936,
          "y": 120
        },
        "data": {
          "disableBlock": false,
          "description": "The click ran",
          "dataList": [
            {
              "type": "variable",
              "name": "result",
              "value": "clicked"
            }
          ]
        }
      },
      {
        "id": "failed",
        "label": "insert-data",
        "type": "BlockBasic",
        "position": {
          "x": 1216,
          "y": 120
        },
        "data": {
          "disableBlock": false,
          "description": "The link was missing after retries",
          "dataList": [
            {
              "type": "variable",
              "name": "result",
              "value": "click failed"
            }
          ]
        }
      }
