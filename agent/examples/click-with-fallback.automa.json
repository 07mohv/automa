      },
      {
        "id": "edge-3",
        "source": "click",
        "target": "ok",
        "sourceHandle": "click-output-1",
        "targetHandle": "ok-input-1",
        "class": "source-click-output-1 target-ok-input-1"
      },
      {
        "id": "edge-4",
        "source": "click",
        "target": "failed",
        "sourceHandle": "click-output-fallback",
        "targetHandle": "failed-input-1",
